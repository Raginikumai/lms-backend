// prisma/schema/schema.prisma

generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Make sure this matches your .env variable name
}

// Enum for user roles

enum RoleEnum {
  STUDENT
  INSTRUCTOR
  ADMIN
}

// User model definition

model User {
  id                String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY
  firstName         String?   @map("first_name") // varchar (nullable)
  lastName          String?   @map("last_name") // varchar (nullable)
  fullName          String?   @map("full_name") // varchar (nullable)
  username          String    @unique // varchar UNIQUE
  role              RoleEnum  @default(STUDENT) // role_enum
  email             String    @unique // varchar UNIQUE
  password          String    // varchar
  profilePic        String?   @map("profile_pic") // varchar (nullable)
  gender            String?   // varchar (nullable)
  createdAt         DateTime  @default(now()) @map("created_at") // timestamp
  updatedAt         DateTime  @updatedAt @map("updated_at") // timestamp
  status            String    @default("active") // varchar DEFAULT 'active'
  profileImageUrl   String?

  // Relations (back-relations from other models)
  // A User can be an instructor for many Courses
  instructedCourses Course[] @relation("InstructorCourses")
  // A User can be a creator for many Courses (created_by)
  createdCourses    Course[] @relation("CreatedByCourses")
  // A User can be a student in many Enrollments
  enrollments       Enrollment[]
  // A User can make many Submissions
  submissions       Submission[]
  // A User can complete many Lessons
  lessonCompletions LessonCompletion[]

  @@map("users") // Maps the Prisma model name 'User' to the 'users' table in the database
}

// prisma/models/course.prisma

model Course {
  id            String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY
  title         String    // varchar
  body          String?   // text (nullable)
  description   String?   // text (nullable)

  // Foreign key for instructor_id
  instructorId  String    @map("instructor_id") // uuid
  // Relation to the User model (instructor)
  instructor    User      @relation("InstructorCourses", fields: [instructorId], references: [id])

  // Foreign key for created_by
  createdById   String    @map("created_by") // integer NOT NULL (changed to String to match User.id)
  // Relation to the User model (creator)
  createdBy     User      @relation("CreatedByCourses", fields: [createdById], references: [id])

  createdAt     DateTime  @default(now()) @map("created_at") // timestamp
  // Note: Your SQL has updated_by as integer, but it should likely reference User.id (uuid).
  // For now, I'll make it String? and you can decide if you want a relation here.
  // If you want a relation, you'd need an `updatedById` field and a relation like `updatedBy User @relation("UpdatedByCourses", fields: [updatedById], references: [id])`
  updatedById   String?   @map("updated_by") // Assuming this should be nullable or have a default
  updatedAt     DateTime  @updatedAt @map("updated_at") // timestamp
  status        String    @default("active") // varchar DEFAULT 'active'

  // Relations (back-relations from other models)
  modules       Module[]
  enrollments   Enrollment[]

  @@map("courses") // Maps the Prisma model name 'Course' to the 'courses' table in the database
}

// prisma/models/enrollment.prisma

model Enrollment {
  id          String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY

  // Foreign key for course_id
  courseId    String    @map("course_id") // uuid NOT NULL
  // Relation to the Course model
  course      Course    @relation(fields: [courseId], references: [id])

  // Foreign key for student_id
  studentId   String    @map("student_id") // uuid NOT NULL
  // Relation to the User model (student)
  student     User      @relation(fields: [studentId], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at") // timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") // timestamp

  // Composite unique index
  @@unique([courseId, studentId])
  @@map("enrollments")
}

// prisma/models/lesson.prisma

model Lesson {
  id          String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY
  title       String    // varchar

  // Foreign key for module_id
  moduleId    String    @map("module_id") // uuid NOT NULL
  // Relation to the Module model
  module      Module    @relation(fields: [moduleId], references: [id])

  contentType String?   @map("content_type") // varchar (nullable)
  content     String?   // varchar (nullable)
  createdAt   DateTime  @default(now()) @map("created_at") // timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") // timestamp

  // Relations (back-relations from other models)
  tests       Test[]
  lessonCompletions LessonCompletion[]

  @@map("lessons")
}

// prisma/models/lessonCompletion.prisma

model LessonCompletion {
  id          String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY

  // Foreign key for student_id
  studentId   String    @map("student_id") // uuid NOT NULL
  // Relation to the User model (student)
  student     User      @relation(fields: [studentId], references: [id])

  // Foreign key for lesson_id
  lessonId    String    @map("lesson_id") // uuid NOT NULL
  // Relation to the Lesson model
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  completedAt DateTime  @default(now()) @map("completed_at") // timestamp DEFAULT (now())

  // Composite unique index
  @@unique([studentId, lessonId])
  @@map("lesson_completions")
}

// prisma/models/module.prisma

model Module {
  id          String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY
  title       String    // varchar

  // Foreign key for course_id
  courseId    String    @map("course_id") // uuid NOT NULL
  // Relation to the Course model
  course      Course    @relation(fields: [courseId], references: [id])

  order       Int?      @map("order") // integer (nullable)
  createdAt   DateTime  @default(now()) @map("created_at") // timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") // timestamp

  // Relations (back-relations from other models)
  lessons     Lesson[]

  @@map("modules")
}

// prisma/models/option.prisma

model Option {
  id          String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY

  // Foreign key for question_id
  questionId  String    @map("question_id") // uuid NOT NULL
  // Relation to the Question model
  question    Question  @relation(fields: [questionId], references: [id])

  optionText  String    @map("option_text") // varchar
  isCorrect   Boolean   @map("is_correct") // boolean
  createdAt   DateTime  @default(now()) @map("created_at") // timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") // timestamp

  // Relations (back-relations from other models)
  submissions Submission[]

  @@map("options")
}

// prisma/models/submission.prisma

model Submission {
  id          String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY

  // Foreign key for student_id
  studentId   String    @map("student_id") // uuid NOT NULL
  // Relation to the User model (student)
  student     User      @relation(fields: [studentId], references: [id])

  // Foreign key for question_id
  questionId  String    @map("question_id") // uuid NOT NULL
  // Relation to the Question model
  question    Question  @relation(fields: [questionId], references: [id])

  // Foreign key for option_id
  optionId    String    @map("option_id") // uuid NOT NULL
  // Relation to the Option model
  option      Option    @relation(fields: [optionId], references: [id])

  score       Int?      // integer (nullable)
  createdAt   DateTime  @default(now()) @map("created_at") // timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") // timestamp

  @@map("submissions")
}

// prisma/models/question.prisma

model Question {
  id            String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY
  questionText  String    @map("question_text") // varchar
  hint          String?   // varchar (nullable)
  explanation   String?   // text (nullable)

  // Foreign key for test_id
  testId        String    @map("test_id") // uuid NOT NULL
  // Relation to the Test model
  test          Test      @relation(fields: [testId], references: [id])

  createdAt     DateTime  @default(now()) @map("created_at") // timestamp
  updatedAt     DateTime  @updatedAt @map("updated_at") // timestamp

  // Relations (back-relations from other models)
  options       Option[]
  submissions   Submission[]

  @@map("questions")
}

// prisma/models/test.prisma

model Test {
  id          String    @id @default(uuid()) @map("id") // uuid PRIMARY KEY
  title       String    // varchar
  mode        String    @default("test") // varchar DEFAULT 'test'

  // Foreign key for lesson_id
  lessonId    String    @map("lesson_id") // uuid NOT NULL
  // Relation to the Lesson model
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at") // timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") // timestamp

  // Relations (back-relations from other models)
  questions   Question[]

  @@map("tests")
}